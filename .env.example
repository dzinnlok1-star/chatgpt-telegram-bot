# ==== Telegram ====
# Получить у @BotFather: /newbot
BOT_TOKEN=123456:ABC-REPLACE_ME
# Список Telegram ID администраторов через запятую
ADMIN_IDS=123456789

# ==== OpenAI ====
# https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-REPLACE_ME
# Необязательно: базовый URL (для проксирования, OpenRouter и т.п.)
OPENAI_BASE_URL=
# Модель по умолчанию (можно менять в админке)
DEFAULT_CHAT_MODEL=gpt-4o-mini
DEFAULT_IMAGE_MODEL=dall-e-3
DEFAULT_TRANSCRIBE_MODEL=whisper-1

# ==== База данных ====
# SQLite (по умолчанию) — ничего не трогать:
DATABASE_URL=sqlite+aiosqlite:///./data/bot.db
# Postgres пример:
# DATABASE_URL=postgresql+asyncpg://user:pass@postgres:5432/chatgpt_bot

# ==== Лимиты по умолчанию (на каждого нового пользователя) ====
FREE_DAILY_MESSAGES=10
FREE_DAILY_IMAGES=1
FREE_DAILY_VOICES=3
CONTEXT_MAX_MESSAGES=20
CONTEXT_MAX_TOKENS=4000

# ==== Бонусы за реферала ====
REFERRAL_BONUS_MESSAGES=50
REFERRAL_BONUS_IMAGES=3

# ==== Тарифы (в звёздах Telegram Stars и в рублях ЮKassa) ====
# Формат: КОД|НАЗВАНИЕ|ДНИ|СООБЩЕНИЯ|КАРТИНКИ|ГОЛОСА|СТОИМОСТЬ_ЗВЁЗДЫ|СТОИМОСТЬ_РУБ
TARIFFS=basic|Базовый|30|500|20|30|150|299;pro|Про|30|2000|100|200|400|799;unlimited|Безлимит|30|100000|500|1000|1000|1990

# ==== ЮKassa ====
# https://yookassa.ru/my/merchant/payment-methods
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
# Публичный URL, на который ЮKassa вернёт клиента после оплаты
YOOKASSA_RETURN_URL=https://t.me/YourBot
# Валюта (RUB по умолчанию)
YOOKASSA_CURRENCY=RUB

# ==== Вебхук-сервер (для ЮKassa уведомлений) ====
# Если не используете — оставьте пустым, бот будет проверять оплату вручную кнопкой
WEBHOOK_HOST=
WEBHOOK_PATH=/yookassa/webhook
WEBHOOK_PORT=8080

# ==== Прочее ====
LOG_LEVEL=INFO
DEFAULT_LANGUAGE=ru
